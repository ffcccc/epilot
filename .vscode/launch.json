{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug epi.exe (Host C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder:epilot}/build/debug/epi.exe",
            "args": ["--files", "${input:bedFile}", "--noprompt"],
            "cwd": "${workspaceFolder:epilot}",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "epilot: build debug",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:CUDA_PATH}/bin;${env:PATH}"
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "bedFile",
            "type": "promptString",
            "description": "PLINK .bed path (with matching .bim and .fam files)",
            "default": "${workspaceFolder:epiload}/data/bed-sample-files/all.bed"
        }
    ]
}